{
	"name": "pi-dreamwalker-theme",
	"version": "0.1.0",
	"description": "Quiet gray chrome for pi: user bar and assistant mark, `Verb target` tool rows with a summary line, a status row above a neutral input card, and a one-line footer. Ships a bundled theme.",
	"type": "module",
	"license": "MIT",
	"keywords": ["pi-package", "pi-extension", "pi-theme", "pi-coding-agent", "tui"],
	"files": ["extensions", "themes", "docs", "README.md"],
	"pi": {
		"extensions": ["./extensions/index.ts"],
		"themes": ["./themes/*.json"]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"check": "npm run typecheck && npm test",
		"bench": "node bench/perf.ts",
		"bench:shimmer": "node bench/shimmer.ts",
		"bench:signal": "node bench/signal.ts",
		"demo:shimmer": "node bench/shimmer-demo.ts",
		"demo:dreamwalker": "node bench/dreamwalker-demo.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@pierre/highlights": "0.2.0",
		"remend": "^1.4.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
